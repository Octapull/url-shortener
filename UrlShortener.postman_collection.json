{
  "info": {
    "name": "Url Shortener API",
    "description": "Postman collection for Url Shortener API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Shorten URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"longUrl\": \"https://www.google.com\",\n  \"recaptchaToken\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/shorten",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shorten"
              ]
            }
          }
        },
        {
          "name": "Redirect",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/:code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ":code"
              ],
              "variable": [
                {
                  "key": "code",
                  "value": "ENTER_SHORT_CODE_HERE"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Google Login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google-login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google-login"
              ]
            }
          }
        },
        {
          "name": "Google Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google-callback?code=AUTH_CODE_FROM_GOOGLE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google-callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "AUTH_CODE_FROM_GOOGLE"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "User Panel",
      "item": [
        {
          "name": "Get All Urls",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/urls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "urls"
              ]
            }
          }
        },
        {
          "name": "Disable Url",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/urls/disable/:code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "urls",
                "disable",
                ":code"
              ],
              "variable": [
                {
                  "key": "code",
                  "value": "ENTER_SHORT_CODE_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Url",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/urls/delete/:code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "urls",
                "delete",
                ":code"
              ],
              "variable": [
                {
                  "key": "code",
                  "value": "ENTER_SHORT_CODE_HERE"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Panel",
      "item": [
        {
          "name": "Get All Urls",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/urls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "urls"
              ]
            }
          }
        },
        {
          "name": "Disable Url",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/urls/disable/:code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "urls",
                "disable",
                ":code"
              ],
              "variable": [
                {
                  "key": "code",
                  "value": "ENTER_SHORT_CODE_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Url",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/urls/delete/:code",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "urls",
                "delete",
                ":code"
              ],
              "variable": [
                {
                  "key": "code",
                  "value": "ENTER_SHORT_CODE_HERE"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "YOUR_JWT_TOKEN_HERE",
